#!/bin/sh

case " $(cat /proc/cmdline) " in
    *" olliterator=provision "*)
        ;;
    *)
        exit 0
        ;;
esac

echo
echo "OLLITERATOR v0.2 PROVISION HOOK: ACTIVE"
echo

/olliterator/provision-stage.sh
rc=$?

if [ "$rc" -eq 0 ]; then
    echo
    echo "OLLITERATOR v0.2: PROVISION AUTHORIZATION COMPLETE"
    echo "CONTINUING TO UBUNTU INSTALLER"
    echo
    exit 0
fi

echo
echo "=============================================="
echo " OLLITERATOR v0.2: FAILURE — PERMANENT HALT"
echo " provision-stage returned rc=$rc"
echo " Ubuntu installer WILL NOT be started."
echo "=============================================="
echo

sync

while :; do
    sleep 3600
done
